{
    "family": "Receiver",
    "name": "Keysight N9936B",
    "tag": "N9936B",
    "band": "5 kHz - 14.1 GHz",
    "image": "Instr_KeySight_N9936B.png",
    "connection": {
        "types": [
            "TCPIP Socket"
        ],
        "defaultPort": 5025,
        "terminator": "LF",
        "traceData": {
            "acquisitionMode": "polling",
            "dataType": "level"
        }
    },
    "communication": {
        "legacy": {
            "initReset": "*RST",
            "initStartup": "*CLS;:INSTrument \"SA\";:FORMat:DATA REAL,32;:AVERage:TYPE VOLT;:DISP:WIND:TRAC1:Y:AUTO;:SYSTem:GPS:STATe INT",
            "initSweepMode": "INITiate:CONTinuous %SweepMode%",
            "setBandConfig": "TRACe1:TYPE %Trace%;:AVERage:COUNt %AverageCount%;:DETector:FUNCtion %Detector%;:AMPLitude:UNIT %LevelUnit%;:FREQuency:STARt %FreqStart%;:FREQuency:STOP %FreqStop%;:SWEep:POINTS %DataPoints%;:BANDwidth:RESolution %ResolutionValue%;:POWer:RF:GAIN %Preamp%;:POWer:RF:ATTenuation %AttenuationValue%;:POWer:RF:ATTenuation:AUTO %AttenuationMode%",
            "setAttenuation": "",
            "setVideoBandWidth": "",
            "queryIdentification": "*IDN?",
            "queryStatus": "SYSTEM:ERROR?",
            "queryBandConfig": "TRACe1:TYPE?;:AVERage:COUNt?;:DETector:FUNCtion?;:AMPLitude:UNIT?;:FREQuency:STARt?;:FREQuency:STOP?;:SWEep:POINTS?;:BANDwidth:RESolution:AUTO?;:BANDwidth:RESolution?;:POWer:RF:GAIN?;:POWer:RF:ATTenuation:AUTO?;:POWer:RF:ATTenuation?;:SWEep:ACQuisition:AUTO?;:SWEep:TIME?;:BANDwidth:VIDeo?",
            "queryAttenuation": "POWer:RF:ATTenuation?",
            "fetchTraceData": "INITiate:RESTart;*WAI;:TRACe1:DATA?",
            "fetchGpsData": "SYSTem:GPS:DATA?"
        },
        "set": [
            {
                "step": "initialization",
                "commands": [
                    {
                        "name": "reset",
                        "parameterNames": [
                            "reset"
                        ],
                        "mandatory": false,
                        "postDelay": 1
                    },
                    {
                        "name": "startup",
                        "parameterNames": [
                            "startup"
                        ],
                        "mandatory": true,
                        "postDelay": 0
                    },
                    {
                        "name": "sweepMode",
                        "parameterNames": [
                            "sweepMode"
                        ],
                        "mandatory": true,
                        "postDelay": 0
                    }
                ]
            },
            {
                "step": "acquisition",
                "commands": [
                    {
                        "name": "bandConfig",
                        "parameterNames": [
                            "traceMode",
                            "averageCount",
                            "detector",
                            "levelUnit",
                            "freqStart",
                            "freqStop",
                            "dataPoints",
                            "resolutionMode",
                            "resolutionValue",
                            "preamp",
                            "attenuationMode",
                            "attenuationValue",
                            "sampleTimeMode",
                            "sampleTimeValue",
                            "videoBandWidth"
                        ],
                        "mandatory": true,
                        "postDelay": 0.1
                    },
                    {
                        "name": "attenuationValue",
                        "parameterNames": [
                            "attenuationValue"
                        ],
                        "mandatory": false,
                        "postDelay": 0
                    },
                    {
                        "name": "videoBandWidth",
                        "parameterNames": [
                            "videoBandWidth"
                        ],
                        "mandatory": false,
                        "postDelay": 0
                    }
                ]
            }
        ],
        "query": {
            "identification": "*IDN?",
            "status": "SYSTEM:ERROR?",
            "bandConfig": "TRACe1:TYPE?;:AVERage:COUNt?;:DETector:FUNCtion?;:AMPLitude:UNIT?;:FREQuency:STARt?;:FREQuency:STOP?;:SWEep:POINTS?;:BANDwidth:RESolution:AUTO?;:BANDwidth:RESolution?;:POWer:RF:GAIN?;:POWer:RF:ATTenuation:AUTO?;:POWer:RF:ATTenuation?;:SWEep:ACQuisition:AUTO?;:SWEep:TIME?;:BANDwidth:VIDeo?",
            "attenuation": "POWer:RF:ATTenuation?"
        },
        "fetch": {
            "traceData": "INITiate:RESTart;*WAI;:TRACe1:DATA?",
            "gpsData": "SYSTem:GPS:DATA?"
        },
        "parameters": [
            {
                "name": "attenuationMode",
                "write": "POWer:RF:ATTenuation:AUTO %AttenuationMode%",
                "read": "POWer:RF:ATTenuation:AUTO?",
                "requireMatch": false
            },
            {
                "name": "attenuationValue",
                "write": "POWer:RF:ATTenuation %AttenuationValue%",
                "read": "POWer:RF:ATTenuation?",
                "requireMatch": false
            },
            {
                "name": "averageCount",
                "write": "AVERage:COUNt %AverageCount%",
                "read": "AVERage:COUNt?",
                "requireMatch": false
            },
            {
                "name": "dataPoints",
                "write": "SWEep:POINTS %DataPoints%",
                "read": "SWEep:POINTS?",
                "requireMatch": false
            },
            {
                "name": "detector",
                "write": "DETector:FUNCtion %Detector%",
                "read": "DETector:FUNCtion?",
                "requireMatch": false
            },
            {
                "name": "freqStart",
                "write": "FREQuency:STARt %FreqStart%",
                "read": "FREQuency:STARt?",
                "requireMatch": false
            },
            {
                "name": "freqStop",
                "write": "FREQuency:STOP %FreqStop%",
                "read": "FREQuency:STOP?",
                "requireMatch": false
            },
            {
                "name": "levelUnit",
                "write": "AMPLitude:UNIT %LevelUnit%",
                "read": "AMPLitude:UNIT?",
                "requireMatch": false
            },
            {
                "name": "preamp",
                "write": "POWer:RF:GAIN %Preamp%",
                "read": "POWer:RF:GAIN?",
                "requireMatch": false
            },
            {
                "name": "reset",
                "write": "*RST",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "resolutionMode",
                "write": "",
                "read": "BANDwidth:RESolution:AUTO?",
                "requireMatch": false
            },
            {
                "name": "resolutionValue",
                "write": "BANDwidth:RESolution %ResolutionValue%",
                "read": "BANDwidth:RESolution?",
                "requireMatch": false
            },
            {
                "name": "sampleTimeMode",
                "write": "",
                "read": "SWEep:ACQuisition:AUTO?",
                "requireMatch": false
            },
            {
                "name": "sampleTimeValue",
                "write": "",
                "read": "SWEep:TIME?",
                "requireMatch": false
            },
            {
                "name": "startup",
                "write": "*CLS;:INSTrument \"SA\";:FORMat:DATA REAL,32;:AVERage:TYPE VOLT;:DISP:WIND:TRAC1:Y:AUTO;:SYSTem:GPS:STATe INT",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "sweepMode",
                "write": "INITiate:CONTinuous %SweepMode%",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "traceMode",
                "write": "TRACe1:TYPE %Trace%",
                "read": "TRACe1:TYPE?",
                "requireMatch": false
            },
            {
                "name": "videoBandWidth",
                "write": "",
                "read": "BANDwidth:VIDeo?",
                "requireMatch": false
            }
        ]
    },
    "features": {
        "attenuationValues": "0 dB,5 dB,10 dB,15 dB,20 dB,25 dB,30 dB,35 dB,40 dB",
        "levelUnits": "DBM,DBUV",
        "stepWidths": "",
        "resolutions": "1.000 kHz,3.000 kHz,10.000 kHz,30.000 kHz,100.000 kHz,300.000 kHz,1000.000 kHz,3000.000 kHz,5000.000 kHz",
        "videoBandWidths": "auto",
        "dataPoints": [
            2,
            20001
        ],
        "detector": {
            "items": "Sample,Average/RMS,Positive Peak,Negative Peak",
            "values": "SAMP,AVER,POS,NEG"
        },
        "sweepMode": {
            "items": "Single Sweep",
            "values": "OFF"
        },
        "traceMode": {
            "items": "ClearWrite,Average,MaxHold,MinHold",
            "values": "CLRW,AVG,MAXH,MINH",
            "requiresAverageModeFor": []
        }
    }
}