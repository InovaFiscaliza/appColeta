{
    "family": "Receiver",
    "name": "Keysight N9344C",
    "tag": "N9344C",
    "band": "1 MHz - 20 GHz",
    "image": "Instr_KeySight_N9344C.png",
    "connection": {
        "types": [
            "TCPIP Socket"
        ],
        "defaultPort": 5025,
        "terminator": "LF",
        "traceData": {
            "acquisitionMode": "polling",
            "dataType": "level"
        }
    },
    "communication": {
        "set": [
            {
                "step": "initialization",
                "commands": [
                    {
                        "name": "reset",
                        "parameterNames": [
                            "reset"
                        ],
                        "mandatory": false,
                        "postDelay": 1
                    },
                    {
                        "name": "startup",
                        "parameterNames": [
                            "startup"
                        ],
                        "mandatory": true,
                        "postDelay": 0
                    },
                    {
                        "name": "sweepMode",
                        "parameterNames": [
                            "sweepMode"
                        ],
                        "mandatory": true,
                        "postDelay": 0
                    }
                ]
            },
            {
                "step": "acquisition",
                "commands": [
                    {
                        "name": "bandConfig",
                        "parameterNames": [
                            "traceMode",
                            "averageMode",
                            "averageCount",
                            "detector",
                            "levelUnit",
                            "freqStart",
                            "freqStop",
                            "resolutionValue",
                            "sensitivityMode",
                            "attenuationValue",
                            "attenuationMode"
                        ],
                        "mandatory": true,
                        "postDelay": 0.1
                    }
                ]
            }
        ],
        "query": {
            "identification": "*IDN?",
            "status": "SYSTEM:ERROR?",
            "bandConfig": "TRACe1:MODE?;:AVERage:TRACe1:STATe?;:AVERage:TRACe1:COUNt?;:DETector:TRACe1:FUNCtion?;:UNIT:POWer?;:FREQuency:STARt?;:FREQuency:STOP?;:BANDwidth:RESolution:AUTO?;:BANDwidth:RESolution?;:POWer:RF:HSENsitive?;:POWer:RF:ATTenuation:AUTO?;:POWer:RF:ATTenuation?;:SWEep:TIME?;:BANDwidth:VIDeo?",
            "attenuation": "POWer:RF:ATTenuation?",
            "bandConfigParameterNames": [
                "traceMode",
                "averageMode",
                "averageCount",
                "detector",
                "levelUnit",
                "freqStart",
                "freqStop",
                "resolutionMode",
                "resolutionValue",
                "sensitivityMode",
                "attenuationMode",
                "attenuationValue",
                "sampleTimeValue",
                "videoBandWidth"
            ]
        },
        "fetch": {
            "traceData": "INITiate:IMMediate;*WAI;:TRACe:DATA? TRACe1",
            "gpsData": "SYSTem:GPSinfo?"
        },
        "parameters": [
            {
                "name": "attenuationMode",
                "write": "POWer:RF:ATTenuation:AUTO %attenuationMode%",
                "read": "POWer:RF:ATTenuation:AUTO?",
                "requireMatch": false
            },
            {
                "name": "attenuationValue",
                "write": "POWer:RF:ATTenuation %attenuationValue%",
                "read": "POWer:RF:ATTenuation?",
                "requireMatch": false
            },
            {
                "name": "averageCount",
                "write": "AVERage:TRACe1:COUNt %averageCount%",
                "read": "AVERage:TRACe1:COUNt?",
                "requireMatch": false
            },
            {
                "name": "averageMode",
                "write": "AVERage:TRACe1:STATe %averageMode%",
                "read": "AVERage:TRACe1:STATe?",
                "requireMatch": false
            },
            {
                "name": "detector",
                "write": "DETector:TRACe1:FUNCtion %detector%",
                "read": "DETector:TRACe1:FUNCtion?",
                "requireMatch": true
            },
            {
                "name": "freqStart",
                "write": "FREQuency:STARt %freqStart%",
                "read": "FREQuency:STARt?",
                "requireMatch": true
            },
            {
                "name": "freqStop",
                "write": "FREQuency:STOP %freqStop%",
                "read": "FREQuency:STOP?",
                "requireMatch": true
            },
            {
                "name": "levelUnit",
                "write": "UNIT:POWer %levelUnit%",
                "read": "UNIT:POWer?",
                "requireMatch": true
            },
            {
                "name": "reset",
                "write": "*RST",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "resolutionMode",
                "write": "",
                "read": "BANDwidth:RESolution:AUTO?",
                "requireMatch": false
            },
            {
                "name": "resolutionValue",
                "write": "BANDwidth:RESolution %resolutionValue%",
                "read": "BANDwidth:RESolution?",
                "requireMatch": true
            },
            {
                "name": "sampleTimeValue",
                "write": "",
                "read": "SWEep:TIME?",
                "requireMatch": false
            },
            {
                "name": "sensitivityMode",
                "write": "POWer:RF:HSENsitive %sensitivityMode%",
                "read": "POWer:RF:HSENsitive?",
                "requireMatch": false
            },
            {
                "name": "startup",
                "write": "*CLS;:INSTrument SA;:FORMat:DATA REAL;:AVERage:TYPE VOLT;:SYSTem:CONFigure:GPS 1",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "sweepMode",
                "write": "INITiate:CONTinuous %sweepMode%",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "traceMode",
                "write": "TRACe1:MODE %traceMode%",
                "read": "TRACe1:MODE?",
                "requireMatch": true
            },
            {
                "name": "videoBandWidth",
                "write": "",
                "read": "BANDwidth:VIDeo?",
                "requireMatch": false
            }
        ]
    },
    "features": {
        "attenuationValues": "0 dB,5 dB,10 dB,15 dB,20 dB,25 dB,30 dB,35 dB,40 dB,45 dB,50 dB",
        "levelUnits": "DBM,DBM",
        "stepWidths": "",
        "resolutions": "1.000 kHz,3.000 kHz,10.000 kHz,30.000 kHz,100.000 kHz,300.000 kHz,1000.000 kHz,3000.000 kHz",
        "videoBandWidths": "auto",
        "dataPoints": [
            461,
            461.001
        ],
        "detector": {
            "items": "Sample,Average/RMS,Positive Peak,Negative Peak",
            "values": "SAMP,AVER,POS,NEG"
        },
        "sweepMode": {
            "items": "Single Sweep",
            "values": "OFF"
        },
        "traceMode": {
            "items": "ClearWrite,Average,MaxHold,MinHold",
            "values": "WRIT,WRIT,MAXH,MINH",
            "requiresAverageModeFor": [
                0,
                1,
                1,
                1
            ]
        }
    }
}