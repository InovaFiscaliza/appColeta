{
    "family": "Receiver",
    "name": "R&S FSL",
    "tag": "FSL",
    "band": "9 kHz - 6 GHz",
    "image": "Instr_R&S_FSL.png",
    "connection": {
        "types": [
            "TCPIP Socket"
        ],
        "defaultPort": 5025,
        "terminator": "LF",
        "traceData": {
            "acquisitionMode": "polling",
            "dataType": "level"
        }
    },
    "communication": {
        "set": [
            {
                "step": "initialization",
                "commands": [
                    {
                        "name": "reset",
                        "parameterNames": [
                            "reset"
                        ],
                        "mandatory": false,
                        "postDelay": 1
                    },
                    {
                        "name": "startup",
                        "parameterNames": [
                            "startup"
                        ],
                        "mandatory": true,
                        "postDelay": 0
                    },
                    {
                        "name": "sweepMode",
                        "parameterNames": [
                            "sweepMode"
                        ],
                        "mandatory": true,
                        "postDelay": 0
                    }
                ]
            },
            {
                "step": "acquisition",
                "commands": [
                    {
                        "name": "bandConfig",
                        "parameterNames": [
                            "traceMode",
                            "averageCount",
                            "detector",
                            "levelUnit",
                            "freqStart",
                            "freqStop",
                            "dataPoints",
                            "resolutionValue",
                            "videoBandWidth",
                            "preamp",
                            "attenuationValue",
                            "attenuationMode"
                        ],
                        "mandatory": true,
                        "postDelay": 0.1
                    }
                ]
            }
        ],
        "query": {
            "identification": "*IDN?",
            "status": "SYSTEM:ERROR?",
            "bandConfig": "DISPlay:WINDow:TRACe1:MODE?;:SWEep:COUNt?;:DETector1:FUNCtion?;:UNIT:POWer?;:FREQuency:STARt?;:FREQuency:STOP?;:SWEep:POINTS?;:BANDwidth:RESolution:AUTO?;:BANDwidth:RESolution?;:INPut:GAIN:STATe?;:INPut:ATTenuation:AUTO?;:INPut:ATTenuation?;:SWEep:TIME?;:FREQuency:STARt? MIN;:FREQuency:STOP? MAX;:BANDwidth:VIDeo?",
            "attenuation": "INPut:ATTenuation?",
            "bandConfigParameterNames": [
                "traceMode",
                "averageCount",
                "detector",
                "levelUnit",
                "freqStart",
                "freqStop",
                "dataPoints",
                "resolutionMode",
                "resolutionValue",
                "preamp",
                "attenuationMode",
                "attenuationValue",
                "sampleTimeValue",
                "minFreqRange",
                "maxFreqRange",
                "videoBandWidth"
            ]
        },
        "fetch": {
            "traceData": "INITiate:IMMediate;*WAI;:TRACe:DATA? TRACe1",
            "gpsData": ""
        },
        "parameters": [
            {
                "name": "attenuationMode",
                "write": "INPUT:ATTenuation:AUTO %attenuationMode%",
                "read": "INPut:ATTenuation:AUTO?",
                "requireMatch": false
            },
            {
                "name": "attenuationValue",
                "write": "INPut:ATTenuation %attenuationValue%",
                "read": "INPut:ATTenuation?",
                "requireMatch": false
            },
            {
                "name": "averageCount",
                "write": "SWEep:COUNt %averageCount%",
                "read": "SWEep:COUNt?",
                "requireMatch": false
            },
            {
                "name": "dataPoints",
                "write": "SWEep:POINTS %dataPoints%",
                "read": "SWEep:POINTS?",
                "requireMatch": true
            },
            {
                "name": "detector",
                "write": "DETector1:FUNCtion %detector%",
                "read": "DETector1:FUNCtion?",
                "requireMatch": true
            },
            {
                "name": "freqStart",
                "write": "FREQuency:STARt %freqStart%",
                "read": "FREQuency:STARt?",
                "requireMatch": true
            },
            {
                "name": "freqStop",
                "write": "FREQuency:STOP %freqStop%",
                "read": "FREQuency:STOP?",
                "requireMatch": true
            },
            {
                "name": "levelUnit",
                "write": "UNIT:POWer %levelUnit%",
                "read": "UNIT:POWer?",
                "requireMatch": true
            },
            {
                "name": "maxFreqRange",
                "write": "",
                "read": "FREQuency:STOP? MAX",
                "requireMatch": false
            },
            {
                "name": "minFreqRange",
                "write": "",
                "read": "FREQuency:STARt? MIN",
                "requireMatch": false
            },
            {
                "name": "preamp",
                "write": "INPut:GAIN:STATe %preamp%",
                "read": "INPut:GAIN:STATe?",
                "requireMatch": false
            },
            {
                "name": "reset",
                "write": "*RST",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "resolutionMode",
                "write": "",
                "read": "BANDwidth:RESolution:AUTO?",
                "requireMatch": false
            },
            {
                "name": "resolutionValue",
                "write": "BANDwidth:RESolution %resolutionValue%",
                "read": "BANDwidth:RESolution?",
                "requireMatch": true
            },
            {
                "name": "sampleTimeValue",
                "write": "",
                "read": "SWEep:TIME?",
                "requireMatch": false
            },
            {
                "name": "startup",
                "write": "*CLS;:INSTrument SAN;:FORMat:DATA REAL,32;:AVERage:TYPE LINear",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "sweepMode",
                "write": "INITiate:CONTinuous %sweepMode%",
                "read": "",
                "requireMatch": false
            },
            {
                "name": "traceMode",
                "write": "DISPlay:WINDow:TRACe1:MODE %traceMode%",
                "read": "DISPlay:WINDow:TRACe1:MODE?",
                "requireMatch": true
            },
            {
                "name": "videoBandWidth",
                "write": "BANDwidth:VIDeo %videoBandWidth%",
                "writeAuto": "BANDwidth:VIDeo:AUTO ON",
                "read": "BANDwidth:VIDeo?",
                "requireMatch": false
            }
        ]
    },
    "features": {
        "attenuationValues": "0 dB,5 dB,10 dB,15 dB,20 dB,25 dB,30 dB",
        "levelUnits": "DBM,DBUV",
        "stepWidths": "",
        "resolutions": "1.000 kHz,3.000 kHz,10.000 kHz,30.000 kHz,100.000 kHz,300.000 kHz,1000.000 kHz,3000.000 kHz,10000.000 kHz",
        "videoBandWidths": "auto,0.100 kHz,0.300 kHz,1.000 kHz,3.000 kHz,10.000 kHz,30.000 kHz,100.000 kHz,300.000 kHz,1000.000 kHz,3000.000 kHz,10000.000 kHz",
        "dataPoints": [
            101,
            32001
        ],
        "detector": {
            "items": "Sample,Average/RMS,Positive Peak,Negative Peak",
            "values": "SAMP,RMS,POS,NEG"
        },
        "sweepMode": {
            "items": "Single Sweep",
            "values": "OFF"
        },
        "traceMode": {
            "items": "ClearWrite,Average,MaxHold,MinHold",
            "values": "WRIT,AVER,MAXH,MINH",
            "requiresAverageModeFor": []
        }
    }
}